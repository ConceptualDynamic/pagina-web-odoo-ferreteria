<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Menú Principal del Sitio Web -->
        
        <!-- Inicio (ya existe por defecto, pero aseguramos la secuencia) -->
        
        <!-- Productos -->
        <record id="menu_products" model="website.menu">
            <field name="name">Productos</field>
            <field name="url">/shop</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">20</field>
            <field name="website_id" ref="website.default_website"/>
        </record>

        <!-- Marcas -->
        <record id="menu_brands" model="website.menu">
            <field name="name">Marcas</field>
            <field name="url">/shop?filter_by_brand=1</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">30</field>
            <field name="website_id" ref="website.default_website"/>
        </record>

