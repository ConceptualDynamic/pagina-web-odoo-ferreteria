<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Grupo de Gestión de Catálogo -->
        <record id="group_ferreteria_catalog_manager" model="res.groups">
            <field name="name">Ferretería: Gestor de Catálogo</field>
            <field name="category_id" ref="base.module_category_website"/>
            <field name="comment">Puede gestionar productos, categorías y marcas del catálogo de ferretería.</field>
        </record>

        <!-- Grupo de Administrador de Ferretería -->
        <record id="group_ferreteria_admin" model="res.groups">
            <field name="name">Ferretería: Administrador</field>
            <field name="category_id" ref="base.module_category_website"/>
            <field name="implied_ids" eval="[(4, ref('group_ferreteria_catalog_manager'))]"/>
            <field name="comment">Acceso completo a la configuración de la tienda de ferretería.</field>
        </record>

        <!-- Regla: Usuarios pueden ver marcas publicadas -->
        <record id="product_brand_public_rule" model="ir.rule">
            <field name="name">Marcas: Públicas para todos</field>
            <field name="model_id" ref="model_product_brand"/>
            <field name="domain_force">[('active', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regla: Gestores de catálogo pueden editar marcas -->
        <record id="product_brand_manager_rule" model="ir.rule">
            <field name="name">Marcas: Gestión por Administradores de Catálogo</field>
            <field name="model_id" ref="model_product_brand"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ferreteria_catalog_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
